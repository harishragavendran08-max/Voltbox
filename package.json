{
  "name": "voltbox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc --noEmit && esbuild src/client/price-chart.tsx --bundle --format=iife --minify --outfile=src/main/resources/static/recharts-bundle.js && esbuild src/client/qr-code.ts --bundle --format=iife --minify --outfile=src/main/resources/static/qr-bundle.js",
    "lint": "tsc --noEmit",
    "start": "tsx server.ts",
    "test": "tsx --test src/logic/inventory.test.ts"
  },
  "dependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
